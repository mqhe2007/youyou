# 本地机密，勿提交真实值。复制为 .env 后填写。
CHUNSUN_SECRET_KEY=
CHUNSUN_API_URL=http://localhost:5173/api/v1

# youyou-server 本地开发配置（优先于 CLI 默认值；已有进程环境变量不会被 .env 覆盖）
# 服务端监听端口；嵌入的管理页 /admin 与 API 共用此端口
YOUYOU_SERVER_PORT=8989
# 运行时目录（请写绝对路径；.env 不会展开 $HOME）：数据在 <dir>/data，默认媒体根在 <dir>/media
YOUYOU_SERVER_DIR=/Users/you/youyou-server

# 服务端本地开发配置
DEV_YOUYOU_SERVER_PASSWORD=
